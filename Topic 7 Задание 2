class Employee:
    def __init__(self, name, position, salary):
        self.name = name
        self.position = position
        self._salary = 0
        self.salary = salary  # используем сеттер
        self.__email = self._generate_email()

    def _generate_email(self):
        # имя.фамилия@company.com
        parts = self.name.lower().split()
        if len(parts) >= 2:
            return f"{parts[0]}.{parts[1]}@company.com"
        else:
            return f"{self.name.lower()}@company.com"

    @property
    def salary(self):
        return self._salary

    @salary.setter
    def salary(self, value):
        if value < 0:
            raise ValueError("Зарплата не может быть отрицательной")
        self._salary = value

    def raise_salary(self, percent):
        self.salary += self.salary * percent / 100

    @staticmethod
    def validate_name(name):
        return name.replace(" ", "").isalpha()

    @classmethod
    def from_string(cls, data):
        name, position, salary = data.split(',')
        return cls(name.strip(), position.strip(), float(salary))
