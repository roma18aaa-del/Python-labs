while True:
    try:
        hour = int(input("Введите час (0-23): "))
        if 0 <= hour <= 23:
            break
        else:
            print("Час должен быть от 0 до 23.")
    except ValueError:
        print("Введите целое число.")

if 6 <= hour <= 11:
    print("Доброе утро!")
elif 12 <= hour <= 17:
    print("Добрый день!")
elif 18 <= hour <= 23:
    print("Добрый вечер!")
else:
    print("Доброй ночи!")
